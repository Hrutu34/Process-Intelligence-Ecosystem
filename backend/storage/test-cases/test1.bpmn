<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_IT" targetNamespace="http://processiq.hackathon">
<bpmn:process id="Proc_IT" name="IT Ticket Resolution" isExecutable="false">
<bpmn:startEvent id="s1" name="Ticket raised"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Log ticket"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t2" name="Categorize ticket"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Assign to agent"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:task id="t4" name="Investigate issue"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
<bpmn:task id="t5" name="Investigate issue"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
<bpmn:task id="t6" name="Apply fix"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:task id="t7" name="Test fix"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:task id="t8" name="Close ticket"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Ticket resolved"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="t4"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" name="" sourceRef="t4" targetRef="t5"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" name="" sourceRef="t5" targetRef="t6"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" name="" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t7" targetRef="t8"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" name="" sourceRef="t8" targetRef="e1"></bpmn:sequenceFlow>
</bpmn:process>
