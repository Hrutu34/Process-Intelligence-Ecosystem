<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_LV" targetNamespace="http://processiq.hackathon">
<bpmn:process id="Proc_LV" name="Leave Request" isExecutable="false">
<bpmn:startEvent id="s1" name="Leave requested"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Submit leave form"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t2" name="Do needful"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Leave recorded"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t9" name="Update HR calendar"></bpmn:task>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="e1"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Dia_Proc_LV"><bpmndi:BPMNPlane id="Plane_Proc_LV" bpmnElement="Proc_LV">
<bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="150" y="90" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="128" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
