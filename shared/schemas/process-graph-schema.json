{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessGraphDTO",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["id", "type", "label"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromId": { "type": "string" },
          "toId": { "type": "string" },
          "condition": { "type": "string" }
        },
        "required": ["fromId", "toId"],
        "additionalProperties": false
      }
    }
  },
  "required": ["nodes", "edges"],
  "additionalProperties": false
}