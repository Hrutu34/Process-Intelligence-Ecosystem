<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1010" y="345" /><di:waypoint x="1055" y="345" /><di:waypoint x="1055" y="323" /><di:waypoint x="1100" y="323" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
