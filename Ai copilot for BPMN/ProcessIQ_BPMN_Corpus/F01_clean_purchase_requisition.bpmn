<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="630" y="330" /><di:waypoint x="675" y="330" /><di:waypoint x="675" y="315" /><di:waypoint x="720" y="315" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="770" y="315" /><di:waypoint x="840" y="315" /><di:waypoint x="840" y="160" /><di:waypoint x="910" y="160" /></bpmndi:BPMNEdge>
