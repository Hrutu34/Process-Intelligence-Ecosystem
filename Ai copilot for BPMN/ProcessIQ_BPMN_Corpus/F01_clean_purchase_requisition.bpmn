<bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1100" y="305" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1090" y="343" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="138" /><di:waypoint x="263" y="138" /><di:waypoint x="263" y="160" /><di:waypoint x="340" y="160" /></bpmndi:BPMNEdge>
