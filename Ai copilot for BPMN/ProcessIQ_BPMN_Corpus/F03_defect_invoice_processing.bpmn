<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_INV" targetNamespace="http://processiq.hackathon">
<bpmn:process id="Proc_INV" name="Invoice Processing" isExecutable="false">
<bpmn:startEvent id="s1" name="Invoice received"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Scan invoice"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t2" name="Match to purchase order"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Process"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:task id="t4" name="Post to accounting"><bpmn:incoming>f4</bpmn:incoming></bpmn:task>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="t4"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Dia_Proc_INV"><bpmndi:BPMNPlane id="Plane_Proc_INV" bpmnElement="Proc_INV">
<bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="150" y="90" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="128" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="340" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="530" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="720" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="910" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="108" /><di:waypoint x="263" y="108" /><di:waypoint x="263" y="130" /><di:waypoint x="340" y="130" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="440" y="130" /><di:waypoint x="530" y="130" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="630" y="130" /><di:waypoint x="720" y="130" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="820" y="130" /><di:waypoint x="910" y="130" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>