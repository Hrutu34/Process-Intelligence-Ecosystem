<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_ONB" targetNamespace="http://processiq.hackathon">
<bpmn:process id="Proc_ONB" name="Employee Onboarding" isExecutable="false">
<bpmn:startEvent id="s1" name="New hire accepted"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Collect employee documents"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="gs" name="Prepare in parallel"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="t2" name="Create IT accounts"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Assign workstation"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:task id="t4" name="Enroll in payroll"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="gj" name="All ready"><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="t5" name="Conduct induction"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Onboarding complete"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="gs"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="" sourceRef="gs" targetRef="t2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" name="" sourceRef="gs" targetRef="t3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" name="" sourceRef="gs" targetRef="t4"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" name="" sourceRef="t2" targetRef="gj"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" name="" sourceRef="t3" targetRef="gj"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t4" targetRef="gj"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" name="" sourceRef="gj" targetRef="t5"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f10" name="" sourceRef="t5" targetRef="e1"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Dia_Proc_ONB"><bpmndi:BPMNPlane id="Plane_Proc_ONB" bpmnElement="Proc_ONB">
