<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_CC" targetNamespace="http://processiq.hackathon">
<bpmn:process id="Proc_CC" name="Customer Complaint Handling" isExecutable="false">
<bpmn:task id="t1" name="Log complaint"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g1" name="Severity?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t2" name="Escalate to specialist"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Send resolution to customer"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Complaint closed"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="t1" targetRef="g1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f2" name="" sourceRef="g1" targetRef="t2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Dia_Proc_CC"><bpmndi:BPMNPlane id="Plane_Proc_CC" bpmnElement="Proc_CC">
<bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="150" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g1_di" bpmnElement="g1"><dc:Bounds x="340" y="90" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="330" y="142" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="530" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="720" y="90" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="910" y="90" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="900" y="128" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="250" y="130" /><di:waypoint x="295" y="130" /><di:waypoint x="295" y="115" /><di:waypoint x="340" y="115" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="390" y="115" /><di:waypoint x="460" y="115" /><di:waypoint x="460" y="130" /><di:waypoint x="530" y="130" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="630" y="130" /><di:waypoint x="720" y="130" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="820" y="130" /><di:waypoint x="865" y="130" /><di:waypoint x="865" y="108" /><di:waypoint x="910" y="108" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>